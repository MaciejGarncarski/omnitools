{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "import", "node", "promise"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"env": {
		"builtin": true,
		"browser": true,
		"node": true
	},
	"rules": {
		"unicorn/no-empty-file": "off",
		"unicorn/require-module-specifiers": "off",
		"import/no-unassigned-import": "off"
	}
}
