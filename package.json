		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"format": "oxfmt ."
	},
	"devDependencies": {
